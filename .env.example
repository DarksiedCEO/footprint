# Copy to .env (git-ignored) and fill in. Never commit real values.
# Read by the IBKR binding (src/footprint/brokers/ibkr/binding.py). No password goes
# here: the bot connects to IB Gateway, which you sign in to yourself.
# Paper setup: BROKER_HOST=127.0.0.1, BROKER_PORT=4002 (IB Gateway paper),
# BROKER_ACCOUNT_ID=your paper account id (DU...), BROKER_CLIENT_ID=0.
BROKER_HOST=
BROKER_PORT=
BROKER_ACCOUNT_ID=
BROKER_CLIENT_ID=

# Alarm channels (D20): Telegram push for every alarm, SMS if Telegram fails, a phone
# call for critical ones. All six = FULL alerting. Fewer = the program refuses to start
# unless you choose DEGRADED_ALERTING explicitly (--alarms-telegram-only needs the two
# Telegram keys; --alarms-local-only needs none). Setup, test sends and the degraded
# rules: docs/live-paper-runbook.md. Values only here, never in chat or a commit.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALARM_PHONE_NUMBER=
